<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Region packs are downloaded straight from GitHub when the Karoo has Wi-Fi of its own;
         without this the direct client fails and only the Karoo system's relay works. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name="dk.gaijin.karoo.citylimit.CityLimitApplication"
        android:icon="@drawable/ic_city_limit"
        android:label="@string/app_name"
        android:theme="@style/Theme.CityLimit">

        <activity
            android:name="dk.gaijin.karoo.citylimit.ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="dk.gaijin.karoo.citylimit.MAIN" />
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Discovered and bound by Karoo OS as an extension. -->
        <service
            android:name="dk.gaijin.karoo.citylimit.extension.CityLimitExtension"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="io.hammerhead.karooext.KAROO_EXTENSION" />
            </intent-filter>
            <meta-data
                android:name="io.hammerhead.karooext.EXTENSION_INFO"
                android:resource="@xml/extension_info" />
        </service>

        <!-- Lets Karoo OS show app details and offer updates from the latest GitHub release. -->
        <meta-data
            android:name="io.hammerhead.karooext.MANIFEST_URL"
            android:value="https://github.com/ttopholm/karoo-citylimit/releases/latest/download/manifest.json" />
    </application>

</manifest>
